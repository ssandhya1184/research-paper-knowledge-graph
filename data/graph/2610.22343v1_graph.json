    {
      "name": "GeoState",
      "node_type": "Method",
      "description": "A view-decoupled geometry representation for predictive 3D world modeling that separates scene-state evolution from camera-dependent observation.",
      "id": "method::geostate"
    },
    {
      "name": "Scene Tokenizer",
      "node_type": "Method",
      "description": "A component of GeoState that aggregates multi-view GFM features into a view-decoupled scene state.",
      "id": "method::scene_tokenizer"
    },
    {
      "name": "Geometry Decoder",
      "node_type": "Method",
      "description": "A component of GeoState that queries the scene state using camera rays to reconstruct geometry.",
      "id": "method::geometry_decoder"
    },
    {
      "name": "Autoregressive World Model",
      "node_type": "Method",
      "description": "A component of GeoState that predicts future scene states autoregressively.",
      "id": "method::autoregressive_world_model"
    },
    {
      "name": "Camera Prediction Model",
      "node_type": "Method",
      "description": "An optional model that predicts future camera motion.",
      "id": "method::camera_prediction_model"
    },
    {
      "name": "Perceiver-style Tokenizer",
      "node_type": "Method",
      "description": "A type of tokenizer used within the Scene Tokenizer for aggregating features.",
      "id": "method::perceiver_style_tokenizer"
    },
    {
      "name": "Query Transformer",
      "node_type": "Method",
      "description": "A component within the Geometry Decoder that processes scene and ray tokens.",
      "id": "method::query_transformer"
    },
    {
      "name": "Feature Decoder",
      "node_type": "Method",
      "description": "A component within the Geometry Decoder that maps view-conditioned representations to feature levels for the GFM head.",
      "id": "method::feature_decoder"
    },
    {
      "name": "Masked Factorized Transformer",
      "node_type": "Method",
      "description": "The architecture adopted for the Autoregressive World Model.",
      "id": "method::masked_factorized_transformer"
    },
    {
      "name": "VGGT-Ω",
      "node_type": "Method",
      "description": "A frozen geometry foundation model used as a backbone to extract geometry-aware features.",
      "id": "method::vggt"
    },
    {
      "name": "VGGT-Ω dense prediction head",
      "node_type": "Method",
      "description": "A frozen component of VGGT-Ω reused by the Geometry Decoder for depth prediction.",
      "id": "method::vggt_dense_prediction_head"
    },
    {
      "name": "Waymo",
